menu "Platform: STM32H5"

# ==================================
# PLATFORM
# ==================================
config MR_USE_PLATFORM
    def_bool y

config MR_USE_STM32H5
    def_bool y

# ==================================
# CACHE
# ==================================
config MR_USE_DCACHE
    bool "Use data cache port"
    default y
    help
        Enable the STM32H5 DCACHE port. The STM32Cube HAL DCACHE module and
        DCACHE peripheral initialization must be enabled by the application.

config MR_USE_ICACHE
    bool "Use instruction cache port"
    default y
    help
        Enable the STM32H5 ICACHE port. The STM32Cube HAL ICACHE module must
        be enabled by the application.

# ==================================
# CLOCK
# ==================================
config MR_CFG_STM32H5_CLOCK_IRQ_PRIORITY
    int "Clock irq priority"
    default 15
    range 0 15
    help
        NVIC priority for the SysTick interrupt (0=highest, 15=lowest).
        The default matches the priority generated by CubeMX and keeps the
        system tick below application interrupts.

endmenu
