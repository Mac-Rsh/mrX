menu "Platform: Platform abstraction"

# ==================================
# PLATFORM
# ==================================
config MR_USE_PLATFORM
    def_bool y

# ==================================
# SERIES
# ==================================
choice
    prompt "Series"
    default MR_USE_WCH_SERIES_XXX

    config MR_USE_WCH_SERIES_XXX
        bool "XXX"

    config MR_USE_WCH_SERIES_V00X
        bool "V00X"

    config MR_USE_WCH_SERIES_V10X
        bool "V10X"

    config MR_USE_WCH_SERIES_V20X
        bool "V20X"

    config MR_USE_WCH_SERIES_V30X
        bool "V30X"
endchoice

# ==================================
# CLOCK
# ==================================
config MR_CFG_WCH_CLOCK_IRQ_PRIORITY
    int "Clock irq priority"
    default 0
    range 0 15
    help
        NVIC priority for system tick interrupt (0=highest, 15=lowest).
        Lower value = higher priority. Should be the highest priority
        interrupt to ensure accurate timekeeping.

# ==================================
# IRQ-DEFER
# ==================================
config MR_CFG_WCH_DEFER_IRQ_PRIORITY
    depends on MR_USE_IRQ_DEFER
    int "Defer irq priority"
    default 2
    range MR_CFG_WCH_CLOCK_IRQ_PRIORITY 15
    help
        NVIC priority for deferred IRQ workqueue interrupt.
        Must be lower priority (higher number) than clock IRQ.
        Adjust based on your system's real-time requirements.

config MR_USE_WCH_IRQ_DEFER_HOOK
    depends on MR_USE_IRQ_DEFER
    select MR_USE_IRQ_DEFER_HOOK
    def_bool y
    help
        Enable WCH-specific defer IRQ hooks for lifecycle monitoring.
        Provides visibility into when deferred interrupt processing
        becomes active or idle.

endmenu
