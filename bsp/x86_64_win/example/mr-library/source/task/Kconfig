menu "Task options"
    # NAME
    config MR_CFG_TASK_NAME_MAX
        int "task name max length"
        default 8
        range 4 64
        help
            This option sets the maximum length of the task name.
    # PRIORITY
    config MR_CFG_TASK_PRIORITY_MAX
        int "task priority max"
        default 32
        range 1 32
        help
            This option sets the maximum number of task priorities.
    # STACK-OVERFLOW
    config MR_USE_TASK_STACK_OVERFLOW_CHECK
        bool "use task stack overflow check"
        default y
        help
            This option allows you to use the task stack overflow check.
    # IDLE-STACK-SIZE
    comment "IDLE-TASK"
    config MR_CFG_TASK_IDLE_STACK_SIZE
        int "idle task stack size"
        default 512
        range 64 2147483647
        help
            This option sets the stack size of the idle task.
    # MAIN-PRIORITY
    comment "MAIN-TASK"
    config MR_CFG_TASK_MAIN_PRIORITY
        int "main task priority"
        default 15
        range 0 31
        help
            This option sets the priority of the main task(must < (max - 1)).
    # MAIN-STACK-SIZE
    config MR_CFG_TASK_MAIN_STACK_SIZE
        int "main task stack size"
        default 1024
        range 64 2147483647
        help
            This option sets the stack size of the main task.
endmenu
