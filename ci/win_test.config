# mrX Windows Full Test Kconfig preset

# Platform
CONFIG_MR_USE_PLATFORM=y
CONFIG_MR_USE_WIN=y
CONFIG_MR_USE_WIN_IRQ_DEFER_HOOK=y
CONFIG_MR_USE_WIN_UART_TCP=y
CONFIG_MR_CFG_WIN_UART_RX_BUF_SIZE=4096

# Libc (64-bit host, internal libc implementations tested)
CONFIG_MR_USE_ARCH_64B=y
CONFIG_MR_USE_ASSERT=y
CONFIG_MR_USE_MALLOC=y
CONFIG_MR_CFG_HEAP_SIZE=1048576
CONFIG_MR_USE_SPRINTF=y
CONFIG_MR_USE_SSCANF=y
CONFIG_MR_USE_STRING=y
CONFIG_MR_USE_STRING_SAFE=y
CONFIG_MR_USE_ATOMIC_3RD=y
CONFIG_MR_USE_TYPES_STD=y
CONFIG_MR_USE_ERRNO=y

# Kernel
CONFIG_MR_USE_CLOCK_HIRES=y
CONFIG_MR_CFG_TICK_PER_SECOND=1000
CONFIG_MR_CFG_HIRES_TICK_PER_SECOND=1000000
CONFIG_MR_CFG_CLOCK_HOOK_SIZE=8
CONFIG_MR_USE_PRINTF=y
CONFIG_MR_CFG_PRINTF_BUF_SIZE=256
CONFIG_MR_USE_PRINTF_COLOR=y
CONFIG_MR_USE_PRINTF_SAFE=y
CONFIG_MR_USE_LOG=y
CONFIG_MR_CFG_LOG_LEVEL=4
CONFIG_MR_USE_TIMER=y
CONFIG_MR_USE_WORK=y
CONFIG_MR_USE_WORKQUEUE_HOOK=y
CONFIG_MR_USE_IRQ=y
CONFIG_MR_CFG_IRQ_TABLE_SIZE=64
CONFIG_MR_USE_IRQ_DEFER=y
CONFIG_MR_USE_WAIT=y

# Drivers
CONFIG_MR_USE_DRIVER=y
CONFIG_MR_USE_DRIVER_ADC=y
CONFIG_MR_USE_DRIVER_ADC_STREAM=y
CONFIG_MR_USE_DRIVER_DAC=y
CONFIG_MR_USE_DRIVER_DAC_STREAM=y
CONFIG_MR_USE_DRIVER_DMA=y
CONFIG_MR_USE_DRIVER_ETH=y
CONFIG_MR_USE_DRIVER_ETH_STREAM=y
CONFIG_MR_USE_DRIVER_FLASH=y
CONFIG_MR_USE_DRIVER_GPIO=y
CONFIG_MR_USE_DRIVER_I2C=y
CONFIG_MR_USE_DRIVER_PWM=y
CONFIG_MR_USE_DRIVER_RAM=y
CONFIG_MR_USE_DRIVER_SPI=y
CONFIG_MR_USE_DRIVER_SPI_STREAM=y
CONFIG_MR_USE_DRIVER_TMR=y
CONFIG_MR_USE_DRIVER_UART=y
CONFIG_MR_USE_DRIVER_UART_STREAM=y
CONFIG_MR_USE_DRIVER_WDT=y

# Filesystem
CONFIG_MR_USE_FS=y
# CONFIG_MR_USE_FS_MULTIUSER is not set
CONFIG_MR_USE_FS_RAMFS=y
CONFIG_MR_USE_FS_RAMFS_FIFO=y
CONFIG_MR_USE_FS_ROOTFS=y

# Modules
CONFIG_MR_USE_MODULE=y
CONFIG_MR_USE_MODULE_BOOT=y
CONFIG_MR_USE_MODULE_BOOT_SHA256=y
CONFIG_MR_USE_MODULE_BOOT_ECDSA_P256=y
CONFIG_MR_USE_MODULE_BOOT_RECOVERY=y
CONFIG_MR_USE_MODULE_BOOT_AUTH=y
CONFIG_MR_USE_MODULE_BOOT_FAST=y
CONFIG_MR_USE_MODULE_CRYPTO=y
CONFIG_MR_USE_MODULE_CRYPTO_SHA256=y
CONFIG_MR_USE_MODULE_CRYPTO_HMAC_SHA256=y
CONFIG_MR_USE_MODULE_CRYPTO_P256=y
CONFIG_MR_USE_MODULE_CRYPTO_ECDSA_P256=y
CONFIG_MR_USE_MODULE_RPC=y
CONFIG_MR_USE_MODULE_RPC_HOOK=y
CONFIG_MR_USE_MODULE_RPC_SELF_DESC=y
CONFIG_MR_CFG_MODULE_RPC_SESSION_NUM=4
CONFIG_MR_CFG_MODULE_RPC_FIFO_SIZE=512
CONFIG_MR_USE_MODULE_XVM=y
CONFIG_MR_USE_MODULE_XVM_MMIO=y
CONFIG_MR_USE_MODULE_XVM_DEBUG=y
CONFIG_MR_USE_MODULE_XVM_GDB=y

# Test
CONFIG_MR_USE_TEST=y
