menu "Drivers options"

# ==================================
# DRIVER
# ==================================
config MR_USE_DRIVER
    bool "Use driver"
    default n

config MR_USE_DRIVER_IRQ
    select MR_USE_WAIT
    bool "Use driver irq"
    default n

# ==================================
# RSOURCE
# ==================================
rsource "*/Kconfig"

endmenu
