menu "Kernel options"
    # ENTRY
    config MR_USE_ENTRY
        depends on !MR_USE_KOS
        bool "Use entry"
        default n
        help
            This option controls whether to use entry.
    # KCLOCK
    config MR_CFG_KCLOCK_HOOK_SIZE
        int "Kclock hook size"
        default 4
        range 2 32
        help
            This option controls the size of the clock hook.
    # KOBJECT
    config MR_CFG_KOBJECT_INAME_SIZE
        int "Kobject inline name size"
        default 16
        range 4 256
        help
            This option controls the size of the inline name of the kobject.
    # KPRINTF
    config MR_USE_KPRINTF
        bool "Use kprintf"
        default n
        help
            This option controls whether to use kprintf.
    config MR_CFG_KPRINTF_BUF_SIZE
        depends on MR_USE_KPRINTF
        int "Kprintf buffer size"
        default 128
        range 8 65535
        help
            This option controls the buffer size of the kprintf.
    config MR_USE_KPRINTF_SAFE
        depends on MR_USE_KPRINTF
        bool "Use kprintf safe"
        default n
        help
            This option controls whether to use kprintf safe.
    # TIMER
    config MR_USE_KTIMER
        bool "Use ktimer"
        default n
        help
            This option controls whether to use ktimer.
    config MR_USE_KTIMER_ATTR
        bool "Use ktimer attribute"
        default n
        help
            This option controls whether to use ktimer attribute.
    # WORKQUEUE
    config MR_USE_KWORKQUEUE
        depends on MR_USE_KTIMER
        bool "Use kworkqueue"
        default n
        help
            This option controls whether to use kworkqueue.
    # OS
    source "include/kernel/os/Kconfig"
endmenu
