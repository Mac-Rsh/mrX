menu "Drivers: Hardware abstraction"

# ==================================
# DRIVER
# ==================================
config MR_USE_DRIVER
    select MR_USE_WAIT
    bool "Use driver"
    default n
    help
        Enable unified driver framework providing device registration,
        reference counting, and lifecycle management.
        Required by all peripheral drivers.

config MR_USE_DRIVER_TRACE
    depends on MR_USE_DRIVER
    depends on MR_USE_TRACE
    bool "Use driver trace"
    default n
    help
        Enable trace events for driver setup, shutdown, and release lifecycle
        operations.

# ==================================
# RSOURCE
# ==================================
rsource "*/Kconfig"

endmenu
