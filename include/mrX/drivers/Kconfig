menu "Drivers options"

# ==================================
# DRIVER
# ==================================
config MR_USE_DRIVER
    select MR_USE_WAIT
    bool "Use driver"
    default n

config MR_USE_DRIVER_HARDTREE
    depends on MR_USE_DRIVER
    bool "Use hardtree"
    default y

# ==================================
# RSOURCE
# ==================================
rsource "*/Kconfig"

endmenu
