menu "I2C: Inter-Integrated Circuit bus"

# ==================================
# I2C
# ==================================
config MR_USE_DRIVER_I2C
    select MR_USE_DRIVER
    bool "Use I2C"
    default n
    help
        Enable I2C driver for two-wire serial communication.
        Features:
            - Standard mode (100kHz) and Fast mode (400kHz)
            - 7-bit and 10-bit addressing
            - Repeated start condition support
            - Common for sensors, EEPROMs, and small peripherals

config MR_USE_DRIVER_I2C_GPIOS
    depends on MR_USE_DRIVER_I2C
    select MR_USE_DRIVER_GPIO
    bool "Use I2C-GPIOS"
    default n
    help
        Enable software I2C (bit-banging) using GPIO pins.
        Useful when hardware I2C peripherals are unavailable or additional
        I2C buses are needed. Automatically enables GPIO driver.
        Trade-off: Higher CPU overhead compared to hardware I2C.

endmenu
