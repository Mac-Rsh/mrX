menu "RAM: Memory device driver"

# ==================================
# RAM
# ==================================
config MR_USE_DRIVER_RAM
    depends on MR_USE_DRIVER
    bool "Use RAM"
    default n
    help
        Enable RAM driver for memory device abstraction.
        Provides unified interface for both internal and external memory:
            - SRAM, PSRAM, SDRAM, and similar memory devices
            - Memory-mapped access abstraction
            - Block and byte-level operations
            - Device-specific timing configuration
        Useful for external memory expansion and unified memory management.

endmenu
