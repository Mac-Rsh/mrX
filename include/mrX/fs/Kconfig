menu "Fs: File system"

# ==================================
# FS
# ==================================
config MR_USE_FS
    bool "Use file system"
    select MR_USE_REF_LONG_COUNT
    default n
    help
        Enable the file system. Provides a path-based structure built
        on a directory-entry(dentry) tree, independent inodes with file
        operations, a handle-based open/read/write API, and a file-system
        mount/unmount framework.

config MR_USE_FS_MULTIUSER
    depends on MR_USE_FS
    bool "Use multi-user"
    default n
    help
        Provide a file-system structure(root/cwd) for each caller instead of
        using one global structure. When enabled, the platform must provide
        mr_fs_struct_current() and return the structure owned by the current task.

config MR_CFG_FS_PATH_LEN
    depends on MR_USE_FS
    int "Path length"
    default 260
    range 32 65535
    help
        Maximum length, in characters, of an absolute path. It is the
        recommended buffer size for mr_fs_getcwd(); passing a buffer smaller
        than the actual working-directory path makes mr_fs_getcwd() return
        -MR_ERANGE.

config MR_CFG_FS_INLINE_NAME_LEN
    depends on MR_USE_FS
    int "Short-name inline buffer"
    default 8
    range 2 256
    help
        Size of the in-object buffer used to store short dentry names. This is
        not the maximum file name length. Names shorter than this size are
        stored in the dentry object; longer names are allocated on the heap.
        Increase this value to reduce heap usage when short names are common.

# ==================================
# RSOURCE
# ==================================
rsource "*/Kconfig"

endmenu
