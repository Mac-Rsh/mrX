menu "Fs: File system"

# ==================================
# FS
# ==================================
config MR_USE_FS
    bool "Use file system"
    select MR_USE_REF_LONG_COUNT
    default n
    help
        Enable the file system. Provides a path-based namespace built
        on a directory-entry(dentry) tree, independent inodes with file
        operations, a handle-based open/read/write API, and a file-system
        mount/unmount framework.

config MR_USE_FS_MULTIUSER
    depends on MR_USE_FS
    bool "Use multi-user"
    default n
    help
        Provide a file-system namespace(root/cwd) for each caller instead of
        using one global namespace. When enabled, the platform must provide
        mr_fs_nsp_current() and return the namespace owned by the current task.

config MR_USE_FS_AT
    depends on MR_USE_FS
    bool "Use directory-relative file interfaces"
    default y
    help
        Provide the mr_fs_*at() interfaces for resolving paths relative to an
        open directory handle. This also enables the MR_AT_* path resolution
        flags.

config MR_USE_FS_BY_PATH
    depends on MR_USE_FS
    bool "Use by-path file interfaces"
    default y
    help
        Provide the mr_fs_*_by_path() convenience interfaces. Disable this
        option when applications use open file handles for stat, rename, and
        unlink operations.

config MR_CFG_FS_PATH_LEN
    depends on MR_USE_FS
    int "Path length"
    default 260
    range 32 65535
    help
        Maximum length, in characters, of an absolute path. It is the
        recommended buffer size for mr_fs_getcwd(); passing a buffer smaller
        than the actual working-directory path makes mr_fs_getcwd() return
        -MR_ERANGE.

config MR_CFG_FS_DENTRY_NAME_LEN
    depends on MR_USE_FS
    int "Inline name length"
    default 4
    range 2 256
    help
        Length of the inline buffer used to store short dentry names. Names
        shorter than this length are stored directly in the dentry object,
        avoiding dynamic memory allocation. Increase this value to reduce heap
        usage when short names are common.

config MR_CFG_FS_SYMLINK_MAX
    depends on MR_USE_FS
    int "Symbolic link depth"
    default 16
    range 1 255
    help
        Maximum number of symbolic links followed during a single path
        lookup. Exceeding this limit makes path resolution return -MR_ELOOP.

# ==================================
# RSOURCE
# ==================================
rsource "*/Kconfig"

endmenu
