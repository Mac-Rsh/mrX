menu "RamFs: In-memory file system"

# ==================================
# RAMFS
# ==================================
config MR_USE_FS_RAMFS
    depends on MR_USE_FS
    bool "Use ramfs"
    default n
    help
        Enable the in-memory reference file system(ramfs). It is automatically
        registered at boot and can be mounted by name("ramfs"). Regular files
        are backed by a growable heap buffer. Use it as an example filesystem
        implementation and for testing the FS.

config MR_USE_FS_RAMFS_FIFO
    depends on MR_USE_FS_RAMFS
    bool "Use ramfs FIFO nodes"
    default y
    help
        Enable named FIFO nodes in ramfs. Create them with mr_fs_mkfifo() or
        mr_fs_mknod(path, MR_INODE_FIFO, MR_NULL). First-version FIFOs are
        shared non-blocking byte queues.

config MR_CFG_FS_RAMFS_FIFO_SIZE
    depends on MR_USE_FS_RAMFS_FIFO
    int "Default ramfs FIFO size"
    default 32
    range 1 1048576
    help
        Default byte capacity used when create or mknod allocates a ramfs FIFO.

endmenu
