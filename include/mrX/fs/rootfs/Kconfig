menu "RootFS: Namespace-only file system"

# ==================================
# ROOTFS
# ==================================
config MR_USE_FS_ROOTFS
    depends on MR_USE_FS
    bool "Use rootfs"
    default n
    help
        Enable the namespace-only root file system(rootfs). It is automatically
        registered at boot and can be mounted by name("rootfs"). It maintains
        directories and typed nodes without storing regular-file data. Directory
        enumeration is supported, while read, write, and truncate operations are
        not provided.

endmenu
