menu "Libc options"

# ==================================
# ARCH
# ==================================
choice
    prompt "Arch"
    default MR_USE_ARCH_32B

    config MR_USE_ARCH_32B
        bool "32B"

    config MR_USE_ARCH_64B
        bool "64B"
endchoice

# ==================================
# ASSERT
# ==================================
choice
    prompt "Assertion"
    default MR_USE_ASSERT

    config MR_USE_ASSERT_STD
        bool "STD"

    config MR_USE_ASSERT_3RD
        bool "3RD"

    config MR_USE_ASSERT
        bool "INT"

    config MR_USE_ASSERT_NONE
        bool "NONE"
endchoice

# ==================================
# MALLOC
# ==================================
choice
    prompt "Malloc"
    default MR_USE_MALLOC

    config MR_USE_MALLOC_STD
        bool "STD"

    config MR_USE_MALLOC_3RD
        bool "3RD"

    config MR_USE_MALLOC
        bool "INT"
endchoice

config MR_CFG_HEAP_SIZE
    depends on !MR_USE_MALLOC_STD
        int "Heap memory size"
        default 4096
        range 32 2147483647

# ==================================
# SPRINTF
# ==================================
choice
    prompt "Sprintf"
    default MR_USE_SPRINTF

    config MR_USE_SPRINTF_STD
        bool "STD"

    config MR_USE_SPRINTF_3RD
        bool "3RD"

    config MR_USE_SPRINTF
        bool "INT"
endchoice

# ==================================
# SSCANF
# ==================================
choice
    prompt "Sscanf"
    default MR_USE_SSCANF

    config MR_USE_SSCANF_STD
        bool "STD"

    config MR_USE_SSCANF_3RD
        bool "3RD"

    config MR_USE_SSCANF
        bool "INT"
endchoice

# ==================================
# STRING
# ==================================
choice
    prompt "String"
    default MR_USE_STRING

    config MR_USE_STRING_STD
        bool "STD"

    config MR_USE_STRING_3RD
        bool "3RD"

    config MR_USE_STRING
        bool "INT"
endchoice

config MR_USE_STRING_SAFE
    depends on MR_USE_STRING
        bool "Use string null-ptr safety"
        default n

# ==================================
# ATOMIC
# ==================================
choice
    prompt "Atomic"
    default MR_USE_ATOMIC

    config MR_USE_ATOMIC_3RD
        bool "3RD"

    config MR_USE_ATOMIC
        bool "INT"
endchoice

# ==================================
# TYPES
# ==================================
choice
    prompt "Types"
    default MR_USE_TYPES

    config MR_USE_TYPES_STD
        bool "STD"

    config MR_USE_TYPES
        bool "INT"
endchoice

# ==================================
# ERRNO
# ==================================
choice
    prompt "Errno"
    default MR_USE_ERRNO

    config MR_USE_ERRNO_STD
        bool "STD"

    config MR_USE_ERRNO_3RD
        bool "3RD"

    config MR_USE_ERRNO
        bool "INT"
endchoice

endmenu
