menu "XVM: Virtual machine"

# ==================================
# XVM
# ==================================
config MR_USE_MODULE_XVM
    depends on MR_USE_MODULE
    bool "Use XVM"
    default n
    help
        Enable the extensible virtual machine(XVM). Provides a small virtual
        machine with pluggable instruction-set architectures(ISA):
            - Load and execute binary images(flash) in separate data memory(RAM)
            - Register ISA implementations by name at runtime
            - Instruction-step scheduling with syscall and exception events
            - Pause/resume and status query

config MR_CFG_XVM_SYSCALL_PARAM_NUM
    depends on MR_USE_MODULE_XVM
    int "Syscall parameter number"
    default 7
    range 1 64
    help
        Number of parameter slots in the XVM syscall event. Each slot holds a
        pointer to a 64-bit syscall argument. Increase this value if an ISA
        needs to pass more arguments in a single syscall event.

# ==================================
# MMIO
# ==================================
config MR_USE_MODULE_XVM_MMIO
    depends on MR_USE_MODULE_XVM
    bool "Use XVM MMIO"
    default n
    help
        Enable the extensible MMIO region table for XVM. Host code can register
        custom memory-mapped peripheral callbacks on an XVM instance, and ISA
        backends forward unmatched MMIO accesses to the registered handlers.

config MR_CFG_XVM_MMIO_NUM
    depends on MR_USE_MODULE_XVM_MMIO
    int "MMIO region table size"
    default 8
    range 1 64
    help
        Maximum number of user MMIO regions that can be registered on an XVM.

# ==================================
# DEBUG
# ==================================
config MR_USE_MODULE_XVM_DEBUG
    depends on MR_USE_MODULE_XVM
    bool "Use XVM debug"
    default n
    help
        Enable the XVM debug breakpoint table. The ISA can call
        mr_xvm_break_hit() with the current program counter before fetch.
        Disable this option to omit the table from mr_xvm_t.

config MR_CFG_XVM_BREAKPOINT_NUM
    depends on MR_USE_MODULE_XVM_DEBUG
    int "Breakpoint table size"
    default 16
    range 1 64
    help
        Number of address-compare breakpoint slots in an XVM. An empty table
        keeps the existing execute fast path.

# ==================================
# GDB
# ==================================
config MR_USE_MODULE_XVM_GDB
    depends on MR_USE_MODULE_XVM_DEBUG
    bool "Use XVM GDB"
    default n
    help
        Enable the GDB Remote Serial Protocol adapter for XVM. The host
        supplies byte I/O; the adapter maps RSP packets onto XVM debug
        and execution interfaces.

config MR_CFG_XVM_GDB_PACKET_SIZE
    depends on MR_USE_MODULE_XVM_GDB
    int "GDB receive packet size"
    default 512
    range 272 8192
    help
        Receive buffer size, in bytes, for one GDB RSP packet payload. GDB
        advertises this as PacketSize. The floor is 272 because the first
        qSupported query from GDB is about 200 bytes, and the RV32 g/G
        all-register packets need 265 bytes. XML and memory transfers are
        sliced to this size. Prefer 512 unless RAM is tight.

config MR_CFG_XVM_GDB_REPLY_SIZE
    depends on MR_USE_MODULE_XVM_GDB
    int "GDB send reply size"
    default 512
    range 272 8192
    help
        Send buffer size, in bytes, for one GDB RSP reply, including packet
        framing. Target XML is generated in slices, so this buffer does not
        need to hold the full document. The floor is 272 because an RV32
        g-packet is 264 hex bytes plus four framing bytes. Prefer 512 unless
        RAM is tight.

# ==================================
# RSOURCE
# ==================================
rsource '*/*/Kconfig'

endmenu
