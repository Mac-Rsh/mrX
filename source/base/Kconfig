menu "Base options"
    # DEBUG-RELEASE
    choice
        prompt "build type"
        default MR_USE_DEBUG
        help
            This option sets the build type.
        # DEBUG
        config MR_USE_DEBUG
            bool "debug"
            help
                This option sets the build type to debug.
        # RELEASE
        config MR_USE_RELEASE
            bool "release"
            help
                This option sets the build type to release.
    endchoice
    # LIBC
    config MR_USE_LIBC
        bool "use libc"
        default n
        help
            This option allows you to use the C runtime library.
    # HEAP
    comment "HEAP"
    config MR_CFG_HEAP_SIZE
    depends on !MR_USE_LIBC
        int "heap size (bytes)"
        default 16384
        range 16 2147483647
        help
            This option sets the size of the heap used by the library.
    # LOG
    comment "LOG"
    config MR_USE_LOG
    depends on MR_USE_DEBUG
        bool "use log"
        default y
    # LOG-LEVEL
    config MR_CFG_LOG_LEVEL
    depends on MR_USE_LOG
        int "log level"
        default 4
        range 0 4
        help
            This option sets the log level.
            0: None
            1: Error
            2: Warning
            3: Info
            4: Debug
endmenu
