/*
 * RPC unit-test schema
 *
 * Regenerate the RPC codec from the mrX directory with:
 * python ./scripts/cli.py rpc-idl -i ./test/modules/rpc/rpc.idl --no-cpp
 */

enum status: u8 {
    ok = 0,
    busy = 1,
    fail = 2,
};

struct point {
    x: i16;
    y: i16;
};

struct sample {
    id: u32;
    name: u8<24>;
    pos: point;
    tags: u8[4];
    st: status;
};

struct kv {
    key: u8<12>;
    val: u32;
};

service lab @1 {
    mix @0 (
        title: u8<16>,
        count: u32,
        note: u8<32>,
        blob: u8<40>
    ) -> (
        title: u8<16>,
        count: u32,
        note: u8<32>,
        blob: u8<40>
    );
    nest @1 (item: sample) -> (item: sample);
    table @2 (rows: kv[2]) -> (rows: kv[2]);
    ping @3 () -> ();
    log @4 (msg: u8<48>);
};
